# Copiar a .env (no se versiona).
POSTGRES_DB=aula_virtual_dev
POSTGRES_USER=aula
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_PORT=5433
API_PORT=5087
# Mínimo 32 caracteres.
JWT_SIGNING_KEY=cambia-esta-clave-de-al-menos-32-caracteres
FRONTEND_ORIGIN=http://localhost:3000

# Almacenamiento R2 (portadas, archivos): desactivado en local y docker-compose no lo pasa a la API.
# En staging/producción se configura con variables Storage__R2__* (ver «Configuración» en el README).
