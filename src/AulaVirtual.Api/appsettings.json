{
  "Authentication": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "MaximumFailedLoginAttempts": 5,
    "LockoutMinutes": 10,
    "Jwt": {
      "Issuer": "AulaVirtual.Api",
      "Audience": "AulaVirtual.Web"
    },
    "LoginRateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "PasswordHashing": {
      "MemorySizeKiB": 65536,
      "Iterations": 2,
      "Parallelism": 1,
      "SaltSizeBytes": 16,
      "HashSizeBytes": 32
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "PublicApi": {
    "RateLimit": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
